import matplotlib.pyplot as plt
import numpy as np
import seaborn as sns
sns.set_theme(style="white", font="Times New Roman", font_scale=1.5)

# Given parameters
line_color = "#DFAC6C"  # Added '#' to make it a valid hex color code
y = [0.54, 1.06, 3.44, 4.16]
labels = ["7B", "13B", "33B", "65B"]
y_label = "Average improvement (MMLU tasks)"
x_label = "7 models of size"

# Create the figure and axis
fig, ax = plt.subplots(figsize=(8, 6))

# Create the bar plot
ax.bar(labels, y, color=line_color)

# Set the labels and title
ax.set_xlabel(x_label)
ax.set_ylabel(y_label)

# Remove unnecessary elements
ax.spines['top'].set_visible(False)
ax.spines['right'].set_visible(False)

ax.spines['bottom'].set_visible(False)
ax.spines['left'].set_visible(False)

# Show the plot
plt.tight_layout()
plt.show()
