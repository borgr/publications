import matplotlib.pyplot as plt
import numpy as np
import seaborn as sns
sns.set_theme(style="white", font="Times New Roman", font_scale=2)

# Given parameters
base_color = "gray"
fuse_color = "#479859"
multitask_color = "#CF347A"
cold_color = "#E79E39"

y = [0.92, 1.62, 2.33]
labels = ["Averaging", "Multitask", "Iterative Averaging (CoLD)"]
y_label = "Improvements over base model with 36 tasks"


# Create the figure and axis
fig, ax = plt.subplots(figsize=(8, 6))

# Create the bar plot
ax.bar(labels, y, color=[fuse_color, multitask_color, cold_color])

# Set the labels and title
# ax.set_xlabel(x_label)
ax.set_ylabel(y_label)

# Remove unnecessary elements
ax.spines['top'].set_visible(False)
ax.spines['right'].set_visible(False)

ax.spines['bottom'].set_visible(False)
ax.spines['left'].set_visible(False)

# Show the plot
plt.tight_layout()
plt.show()
